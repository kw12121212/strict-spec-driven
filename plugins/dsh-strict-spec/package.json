{
  "name": "dsh-plugin-strict-spec",
  "version": "0.2.0",
  "private": true,
  "description": "Strict workflow document viewer plugin for DeepSeek Harness",
  "type": "module",
  "main": "./dist/host.js",
  "exports": {
    ".": "./dist/host.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.2.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "scripts": {
    "build": "bun scripts/build-client.ts",
    "lint": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-workspace-files": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-shortcuts": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-dockkit": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-package-manifest": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-code-language": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-rc.2",
    "@shikijs/langs": "^4.4.3",
    "@tanstack/react-virtual": "^3.14.21",
    "@types/bun": "^1.4.3",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "anser": "^2.3.5",
    "clsx": "^2.0.0",
    "diff": "^9.0.0",
    "immer": "^10.1.1",
    "js-yaml": "4.1.1",
    "katex": "^0.18.7",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.0.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.0.0",
    "micromark-factory-space": "^2.1.0",
    "micromark-util-character": "^2.1.0",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "shiki": "^4.4.3",
    "simple-icons": "16.31.0",
    "typescript": "^5.9.3",
    "zustand": "~4.5.7"
  }
}
