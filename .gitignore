# Dependencies
node_modules/

# Build output (keep the pre-built bundle for distribution)
dist/*
!dist/scripts/
dist/scripts/*
!dist/scripts/strict-spec-driven.js
!dist/scripts/strict-spec-driven-mcp.js

# The dsh plugin's built bundle is tracked beside its sources: the package's
# main, exports, and bundle patch resolve into it, and every channel that runs
# no build — a checkout, a link: spec, a directory spec, a git reference —
# installs only what the repository carries. Rebuild it with `bun run build`
# inside plugins/dsh-strict-spec; the plugin suite fails when it drifts.
# Locally packed plugin tarballs (npm pack inside the plugin, per its README)
plugins/dsh-strict-spec/*.tgz

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# Strict runtime state
.strict-spec-driven/.runtime/

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
