{
  "name": "strict-spec-driven",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc && rm -rf dist/templates dist/scripts && cp -r templates dist/templates && cp -r scripts dist/scripts",
    "install-strict-skills": "bash install.sh",
    "install-strict-skills:project": "bash install.sh --project",
    "test": "bun test/run.ts",
    "uninstall-strict-skills": "bash install.sh --uninstall",
    "uninstall-strict-skills:project": "bash install.sh --uninstall --project",
    "validate-skills": "bun run build && node dist/strict-spec-cli.js validate-skills"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "js-yaml": "4.1.1"
  }
}
